install.packages("data.table")
library(data.table)
cat("DATA.TABLE PACKAGE LOADED SUCCESSFULLY!\n")
# Load packages
library(data.table)
# Load cleaned dataset
retail_clean <- readRDS(
"data/processed/retail_cleaned.rds"
)
# Convert to data.table
retail_dt <- as.data.table(retail_clean)
# Check dimensions
dim(retail_dt)
# Calculate revenue by country
country_revenue_dt <- retail_dt[
,
.(Total_Revenue = sum(Revenue, na.rm = TRUE)),
by = Country
]
# Display top 10 countries
country_revenue_dt[
order(-Total_Revenue)
][1:10]
cat("DATA.TABLE OPTIMISATION TEST COMPLETED!\n")
library(purrr)
cat("PURRR PACKAGE LOADED SUCCESSFULLY!\n")
library(purrr)
# List report files
report_files <- list.files(
"reports",
pattern = "\\.csv$",
full.names = TRUE
)
# Load multiple CSV reports using purrr
report_data <- map(
report_files,
read.csv
)
# Give each dataset its filename
names(report_data) <- basename(report_files)
# Check number of loaded reports
length(report_data)
# Display report names
names(report_data)
# Check first report
head(report_data[[1]])
cat("PURRR MULTIPLE REPORT LOADING COMPLETED!\n")
